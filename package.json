{
  "name": "apex-frontend",
  "version": "1.0.1",
  "nativeBuildNumber": 9,
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:mobile": "vite build && node scripts/sync-native-version.mjs && LANG=en_US.UTF-8 pnpm exec cap sync && node scripts/patch-ios-info-plist.mjs && node scripts/assert-baked-capacitor-config.mjs",
    "build:mobile:staging": "vite build --mode staging && node scripts/sync-native-version.mjs && LANG=en_US.UTF-8 pnpm exec cap sync && node scripts/patch-ios-info-plist.mjs && node scripts/assert-baked-capacitor-config.mjs",
    "build:mobile:dev": "vite build --mode mobile && node scripts/sync-native-version.mjs && LANG=en_US.UTF-8 pnpm exec cap sync && node scripts/patch-ios-info-plist.mjs && node scripts/assert-baked-capacitor-config.mjs",
    "cap:add": "LANG=en_US.UTF-8 pnpm exec cap add ios --packagemanager CocoaPods && LANG=en_US.UTF-8 pnpm exec cap add android",
    "assets:generate": "pnpm exec capacitor-assets generate --ios --android --logoSplashTargetWidth 700 --iconBackgroundColor '#0e0e0e' --iconBackgroundColorDark '#0e0e0e' --splashBackgroundColor '#0e0e0e' --splashBackgroundColorDark '#0e0e0e'",
    "dev:ios": "node scripts/run-ios.mjs",
    "dev:ios:local": "node scripts/run-ios.mjs --mode mobile",
    "cap:run:ios": "LANG=en_US.UTF-8 pnpm exec cap run ios --target-name \"iPhone 15 Pro\"",
    "dev:android": "node scripts/run-android.mjs --live-reload",
    "cap:run:android": "node scripts/run-android.mjs",
    "android:assemble:debug": "node scripts/android-gradle.mjs assembleDebug",
    "cap:sync": "node scripts/sync-native-version.mjs && LANG=en_US.UTF-8 pnpm exec cap sync && node scripts/patch-ios-info-plist.mjs",
    "cap:open:ios": "pnpm exec cap open ios",
    "cap:open:android": "pnpm exec cap open android",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "pretest:e2e": "bash scripts/verify-e2e-secrets.sh",
    "verify:e2e-secrets": "bash scripts/verify-e2e-secrets.sh",
    "assert:safe-target": "node scripts/assert-safe-target.cjs",
    "env:api:local": "node scripts/use-api-env.cjs local",
    "env:api:staging": "node scripts/use-api-env.cjs staging",
    "env:api:prod": "node scripts/use-api-env.cjs prod",
    "test:e2e:ui": "bash scripts/verify-e2e-secrets.sh && playwright test --ui",
    "test:e2e:headed": "bash scripts/verify-e2e-secrets.sh && playwright test --headed",
    "typecheck:e2e": "tsc -p tsconfig.playwright.json --noEmit",
    "format.fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@apexsimtrack/session-contract": "1.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/app": "8.0.1",
    "@capacitor/browser": "8.0.3",
    "@capacitor/core": "8.0.2",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@revenuecat/purchases-capacitor": "^13.4.2",
    "@revenuecat/purchases-js": "^1.41.1",
    "@tanstack/react-query": "^5.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.576.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.72.1",
    "react-paginate": "^8.3.0",
    "react-router-dom": "^7.18.2",
    "react-share": "^5.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uplot": "^1.6.32",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "8.0.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.0.2",
    "@capacitor/ios": "8.0.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "globals": "^17.5.0",
    "knip": "^6.26.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
