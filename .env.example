# =============================================================================
# Apex Frontend — Environment (Vite)
# Copy to .env for local dev. In Vercel, set the same VITE_* vars per environment.
# =============================================================================

# Logical tier label for admin banners (optional; inferred from API host if unset)
# VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# API (required for production / staging builds)
# -----------------------------------------------------------------------------

# Fastify backend base URL (no trailing slash).
# MUST point at the apex API host—not this SPA's Vercel URL.
#
# Local:
#   VITE_API_URL=http://127.0.0.1:10000
#   (Local API should use Neon staging DB via apex/.env — see multi-environment.md)
# Staging (Vercel Preview / staging branch):
#   VITE_API_URL=https://staging-y01y.onrender.com
# Production (Vercel Production / main):
#   VITE_API_URL=https://apex-1-y319.onrender.com
#
# VITE_API_URL=http://127.0.0.1:10000

# Legacy alias (same as VITE_API_URL if set):
# VITE_APEX_API_BASE_URL=http://127.0.0.1:10000

# Vite dev server proxies /api to this target (pnpm dev on :8080):
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:10000

# -----------------------------------------------------------------------------
# RevenueCat native SDK (public app-specific keys; safe to embed in the app)
# -----------------------------------------------------------------------------

# RevenueCat Dashboard → Project settings → API keys → App specific keys.
# Use the Apple key for iOS and Google key for Android. These are different
# from the Web Billing public key returned by GET /api/billing/config.
# Never submit a store build with a RevenueCat Test Store key.
# VITE_REVENUECAT_IOS_API_KEY=appl_your_public_apple_key
# VITE_REVENUECAT_ANDROID_API_KEY=goog_your_public_google_key

# -----------------------------------------------------------------------------
# App branding
# -----------------------------------------------------------------------------

# Footer support mailto (default: support@apexsimtracker.com)
# VITE_SUPPORT_EMAIL=support@yourdomain.com

# Builder.io public key (optional CMS)
# VITE_PUBLIC_BUILDER_KEY=your_builder_key
